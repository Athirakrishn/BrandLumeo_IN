<style>
    .cdf40d50ba-express-hover-cta {
        position: relative;
        width: auto;
        max-width: 1000px;
        height: 32px;
        border-radius: 20px;
        cursor: pointer;
        background-color: #FFFFFF;
        color: #333;
        display: flex;
        align-items: center;
        font-family: "Adobe Clean", adobe-clean, "AdobeClean-Regular", sans-serif !important;
        justify-content: center;
        box-sizing: border-box;
        -webkit-box-sizing: border-box;
        -moz-box-sizing: border-box;
        transition: all 300ms ease;
    }

    .gmailMessageView.minify {
        top: 0;
    }

    .gmailMessageView {
        all: initial;
        top: -4px;
        position: absolute;
        right: 100%;
        padding: 0 !important;
        transition: all 300ms ease;
    }

    .gmailMessageView.minify .cdf40d50ba-express-hover-cta {
        max-width: 25px;
        height: 25px;
        border-radius: 7px;
        box-shadow: none;
    }

    .gmailMessageView.minify .cdf40d50ba-express-edit-cta-button {
        border-radius: 7px;
    }

    .gmailMessageView .cdf40d50ba-express-hover-cta {
        background-color: #6D6D6D;
        color: #FFFFFF;
        padding: 0 !important;
    }

    .gmailMessageView .cdf40d50ba-express-edit-cta-button {
        border-color: #6D6D6D;
    }

    .gmailMessageView .cdf40d50ba-express-expand-menu-icon:hover {
        background-color: #464646;
    }

    .gmailMessageView .cdf40d50ba-express-edit-cta-button:hover {
        background-color: #000000;
        border-color: #4B4B4B;
        box-shadow: none;
    }

    .gmailMessageView .cdf40d50ba-express-expand-menu-icon svg path {
        fill :#D5D5D5
    }

    .gmailMessageView .cdf40d50ba-express-floating-menu {
        bottom: 38px;
        top: unset;
    }

    .minify .cdf40d50ba-express-hover-cta {
        max-width: 26px;
        height: 26px;
        border-radius: 17px;
        box-shadow: 0 1px 4px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.1);
        border: none;
    }

    .minify .cdf40d50ba-express-menu-item-text {
        opacity: 0;
        width: 0;
        margin-left: 0;
        margin-right: 0;
        padding-left: 0;
        padding-right: 0;
    }

    .minify .cdf40d50ba-express-edit-cta-icon {
        width: 24px;
        height: 24px;
        padding-left: 1px !important;
        padding-right: 1px !important;
    }

    .minify .cdf40d50ba-express-edit-cta-icon img {
        width: 24px;
        height: 24px;
        padding: 0 !important;
    }

    .minify .cdf40d50ba-express-edit-cta-button {
        border: none;
        border-color: #B30B00;
        overflow: hidden;
        background-color: #B30B00;
    }

    .minify .cdf40d50ba-express-expand-menu-icon {
        opacity: 0;
        width: 0;
        height: 0;
        padding: 0;
        margin: 0;
    }

    .minify .cdf40d50ba-express-menu-item-text {
        width: 0;
        margin-left: 0;
        margin-right: 0;
        padding-left: 0;
        padding-right: 0;
        transition: all 300ms ease;
    }

    .minify .cdf40d50ba-express-expand-menu-icon-container {
        opacity: 0;
        width: 0;
        height: 0;
        padding: 0;
        margin: 0;
    }

    .cdf40d50ba-express-edit-cta-button {
        display: flex;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
        -webkit-box-sizing: border-box;
        -moz-box-sizing: border-box;
        overflow: hidden;
        width: 100%;
        height: 100%;
        border-width: 2px;
        border-radius: 16px;
        border-style: solid;
        border-color: #DADADA;
        transition: all 300ms ease;
    }

    .cdf40d50ba-express-edit-cta-button img {
        width: 18px;
        height: 18px;
        box-sizing: border-box;
        -webkit-box-sizing: border-box;
        -moz-box-sizing: border-box;
    }

    .cdf40d50ba-express-floating-menu {
        position: absolute;
        top: 38px;
        left: calc(100% - 24px);
        display: none;
        flex-direction: column;
        align-items: stretch;
        background: #FFFFFF;
        min-width: 116px;
        padding: 4px 4px;
        transition: all 0.3s ease;
        z-index: 10001;
        border: 1px solid #D5D5D5;
        box-shadow: 0px 4px 12px 0px rgba(0, 0, 0, 0.08), 0px 2px 6px 0px rgba(0, 0, 0, 0.04), 0px 0px 2px 0px rgba(0, 0, 0, 0.12);
        border-radius: 4px;
        gap: 4px;
        box-sizing: border-box;
        -webkit-box-sizing: border-box;
        -moz-box-sizing: border-box;
    }

    .right .cdf40d50ba-express-floating-menu {
        left: auto;
        right: 0;
    }

    .cdf40d50ba-express-edit-cta-icon {
        width: 18px;
        height: 18px;
        padding-top: 6px !important;
        padding-bottom: 6px !important;
        padding-right: 6px !important;
        padding-left: 14px !important;
        transition: all 300ms ease;
        box-sizing: content-box !important;
        -webkit-box-sizing: content-box !important;
        -moz-box-sizing: content-box !important;
    }

    .cdf40d50ba-express-edit-cta-icon img {
        width: 18px;
        height: 18px;
        transition: all 300ms ease;
    }

    .cdf40d50ba-express-menu-item-text {
        font-size: 14px;
        font-weight: 700;
        font-style: bold;
        white-space: nowrap;
        display: inline-block;
        overflow: hidden;
        transition: all 300ms ease;
    }
    /* Enable trailing gradient fade for overflowing label text when requested */
    .cdf40d50ba-express-menu-item-text.fade-effect {
