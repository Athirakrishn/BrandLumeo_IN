<style>
    .cdf40d50ba-express-hover-cta {
        position: relative;
        width: auto;
        max-width: 1000px;
        height: 32px;
        border-radius: 20px;
        cursor: pointer;
        background-color: #FFFFFF;
        color: #333;
        display: flex;
        align-items: center;
        font-family: "Adobe Clean", adobe-clean, "AdobeClean-Regular", sans-serif !important;
        justify-content: center;
        box-sizing: border-box;
        -webkit-box-sizing: border-box;
        -moz-box-sizing: border-box;
        transition: all 300ms ease;
    }

    .gmailMessageView.minify {
        top: 0;
    }

    .gmailMessageView {
        all: initial;
        top: -4px;
        position: absolute;
        right: 100%;
        padding: 0 !important;
        transition: all 300ms ease;
    }

    .gmailMessageView.minify .cdf40d50ba-express-hover-cta {
        max-width: 25px;
        height: 25px;
        border-radius: 7px;
        box-shadow: none;
    }

    .gmailMessageView.minify .cdf40d50ba-express-edit-cta-button {
        border-radius: 7px;
    }

    .gmailMessageView .cdf40d50ba-express-hover-cta {
        background-color: #6D6D6D;
        color: #FFFFFF;
        padding: 0 !important;
    }

    .gmailMessageView .cdf40d50ba-express-edit-cta-button {
        border-color: #6D6D6D;
    }

    .gmailMessageView .cdf40d50ba-express-expand-menu-icon:hover {
        background-color: #464646;
    }

    .gmailMessageView .cdf40d50ba-express-edit-cta-button:hover {
        background-color: #000000;
        border-color: #4B4B4B;
        box-shadow: none;
    }

    .gmailMessageView .cdf40d50ba-express-expand-menu-icon svg path {
        fill :#D5D5D5
    }

    .gmailMessageView .cdf40d50ba-express-floating-menu {
        bottom: 38px;
        top: unset;
    }

    .minify .cdf40d50ba-express-hover-cta {
        max-width: 26px;
        height: 26px;
        border-radius: 17px;
        box-shadow: 0 1px 4px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.1);
        border: none;
    }

    .minify .cdf40d50ba-express-menu-item-text {
        opacity: 0;
        width: 0;
        margin-left: 0;
        margin-right: 0;
        padding-left: 0;
        padding-right: 0;
    }

    .minify .cdf40d50ba-express-edit-cta-icon {
        width: 24px;
        height: 24px;
        padding-left: 1px !important;
        padding-right: 1px !important;
    }

    .minify .cdf40d50ba-express-edit-cta-icon img {
        width: 24px;
        height: 24px;
        padding: 0 !important;
    }

    .minify .cdf40d50ba-express-edit-cta-button {
        border: none;
        border-color: #B30B00;
        overflow: hidden;
        background-color: #B30B00;
    }

    .minify .cdf40d50ba-express-expand-menu-icon {
        opacity: 0;
        width: 0;
        height: 0;
        padding: 0;
        margin: 0;
    }

    .minify .cdf40d50ba-express-menu-item-text {
        width: 0;
        margin-left: 0;
        margin-right: 0;
        padding-left: 0;
        padding-right: 0;
        transition: all 300ms ease;
    }

    .minify .cdf40d50ba-express-expand-menu-icon-container {
        opacity: 0;
        width: 0;
        height: 0;
        padding: 0;
        margin: 0;
    }

    .cdf40d50ba-express-edit-cta-button {
        display: flex;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
        -webkit-box-sizing: border-box;
        -moz-box-sizing: border-box;
        overflow: hidden;
        width: 100%;
        height: 100%;
        border-width: 2px;
        border-radius: 16px;
        border-style: solid;
        border-color: #DADADA;
        transition: all 300ms ease;
    }

    .cdf40d50ba-express-edit-cta-button img {
        width: 18px;
        height: 18px;
        box-sizing: border-box;
        -webkit-box-sizing: border-box;
        -moz-box-sizing: border-box;
    }

    .cdf40d50ba-express-floating-menu {
        position: absolute;
        top: 38px;
        left: calc(100% - 24px);
        display: none;
        flex-direction: column;
        align-items: stretch;
        background: #FFFFFF;
        min-width: 116px;
        padding: 4px 4px;
        transition: all 0.3s ease;
        z-index: 10001;
        border: 1px solid #D5D5D5;
        box-shadow: 0px 4px 12px 0px rgba(0, 0, 0, 0.08), 0px 2px 6px 0px rgba(0, 0, 0, 0.04), 0px 0px 2px 0px rgba(0, 0, 0, 0.12);
        border-radius: 4px;
        gap: 4px;
        box-sizing: border-box;
        -webkit-box-sizing: border-box;
        -moz-box-sizing: border-box;
    }

    .right .cdf40d50ba-express-floating-menu {
        left: auto;
        right: 0;
    }

    .cdf40d50ba-express-edit-cta-icon {
        width: 18px;
        height: 18px;
        padding-top: 6px !important;
        padding-bottom: 6px !important;
        padding-right: 6px !important;
        padding-left: 14px !important;
        transition: all 300ms ease;
        box-sizing: content-box !important;
        -webkit-box-sizing: content-box !important;
        -moz-box-sizing: content-box !important;
    }

    .cdf40d50ba-express-edit-cta-icon img {
        width: 18px;
        height: 18px;
        transition: all 300ms ease;
    }

    .cdf40d50ba-express-menu-item-text {
        font-size: 14px;
        font-weight: 700;
        font-style: bold;
        white-space: nowrap;
        display: inline-block;
        overflow: hidden;
        transition: all 300ms ease;
    }
    /* Enable trailing gradient fade for overflowing label text when requested */
    .cdf40d50ba-express-menu-item-text.fade-effect {
        /* Fade the last 22px to transparent using mask (works across themes) */
        -webkit-mask-image: linear-gradient(to right, rgba(0,0,0,1) 0, rgba(0,0,0,1) calc(100% - 22px), rgba(0,0,0,0) 100%);
        mask-image: linear-gradient(to right, rgba(0,0,0,1) 0, rgba(0,0,0,1) calc(100% - 22px), rgba(0,0,0,0) 100%);
    }
    /* Ensure no mask when minimized */
    .minify .cdf40d50ba-express-menu-item-text {
        -webkit-mask-image: none !important;
        mask-image: none !important;
    }

    .cdf40d50ba-express-expand-menu-icon-container {
        width: 32px;
        height: 32px;
        display: flex;
        position: relative;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        transition: all 300ms ease;
        box-sizing: border-box;
        -webkit-box-sizing: border-box;
        -moz-box-sizing: border-box;
    }

    .cdf40d50ba-express-expand-menu-icon {
        width: 20px;
        height: 20px;
        align-items: center;
        justify-content: center;
        padding: 3px 3px;
        box-sizing: border-box;
        -webkit-box-sizing: border-box;
        -moz-box-sizing: border-box;
        border-radius: 4px;
        translate: -2px;
    }

    .cdf40d50ba-express-expand-menu-icon:hover svg path {
        fill: #FFFFFF;
    }

    .cdf40d50ba-express-expand-menu-icon svg {
        width: 14px;
        height: 14px;
        align-items: center;
        box-sizing: border-box;
        -webkit-box-sizing: border-box;
        -moz-box-sizing: border-box;
    }

    .cdf40d50ba-close-icon {
        display: none;
    }

    .expand-menu-open .cdf40d50ba-close-icon {
        display: flex;
    }

    .cdf40d50ba-burger-icon {
        display: flex;
    }

    .expand-menu-open .cdf40d50ba-burger-icon {
        display: none;
    }

    .cdf40d50ba-express-expand-menu-icon:hover {
        background-color: #B1B1B1;
    }

    .cdf40d50ba-express-floating-menu-item-text {
        font-weight: 400;
        white-space: nowrap;
    }

    .cdf40d50ba-express-floating-menu-item {
        display: flex;
        align-items: center;
        padding: 0 12px;
        cursor: pointer;
        font-family: "Adobe Clean", adobe-clean, "AdobeClean-Regular", sans-serif !important;
        width: 100%;
        height: 32px;
        font-size: 14px;
        font-weight: 400;
        color: #131313;
        background: transparent;
        transition: background-color 0.2s ease;
        box-sizing: border-box;
        -webkit-box-sizing: border-box;
        -moz-box-sizing: border-box;
    }

    .expand-menu-open .cdf40d50ba-express-floating-menu {
        display: flex;
    }

    .cdf40d50ba-express-edit-cta-button:hover {
        background-color: #E1E1E1;
        border-color: #C6C6C6;
        box-shadow: 0px 4px 12px 0px rgba(0, 0, 0, 0.08), 0px 2px 6px 0px rgba(0, 0, 0, 0.04), 0px 0px 2px 0px rgba(0, 0, 0, 0.12);
    }

    .cdf40d50ba-express-floating-menu-item:hover {
        background-color: #E9E9E9;
    }

    .cdf40d50ba-express-menu-footer {
        height: 19px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: "Adobe Clean", adobe-clean, "AdobeClean-Regular", sans-serif !important;
        font-size: 12px;
        color: #8F8F8F;
        margin-top: 0;
        border-top: none;
        box-sizing: border-box;
        -webkit-box-sizing: border-box;
        -moz-box-sizing: border-box;
    }

    .cdf40d50ba-express-floating-menu-footer-text {
        font-size: 12px;
        font-weight: 300;
        color: #6D6D6D;
    }

    .cc440d50ba-tooltiptext {
      font-family: "Adobe Clean", adobe-clean, "AdobeClean-Bold", sans-serif !important;
      pointer-events: none;
      cursor: default;
      font-weight: 400;
      font-size: 12px;
      visibility: hidden;
      width: 200px;
      top: 119%;
      line-height: 15px;
      background-color: #292929;
      color: #fff;
      text-align: left;
      border-radius: 7px;
      padding: 4px 9px 5px 9px !important;
      position: absolute;
      z-index: 10000;
      box-sizing: border-box;
      -webkit-box-sizing: border-box;
      -moz-box-sizing: border-box;
    }

    .cc440d50ba-tooltiptext-bottom::after {
      content: "";
      position: absolute;
      bottom: 100%;
      left: 50%;
      margin-left: -5px;
      border-width: 5px;
      border-style: solid;
      border-color: transparent transparent #292929 transparent;
    }

    .cc440d50ba-tooltiptext-top::after {
      content: "";
      position: absolute;
      top: 100%;
      left: 50%;
      margin-left: -5px;
      border-width: 5px;
      border-style: solid;
      border-color: #292929 transparent transparent transparent;
    }

    .cc440d50ba-tooltiptext-left::after {
      content: "";
      position: absolute;
      top: 50%;
      left: 100%;
      margin-top: -5px;
      border-width: 5px;
      border-style: solid;
      border-color: transparent transparent transparent #292929;
    }

    .cc440d50ba-tooltiptext-right::after {
      content: "";
      position: absolute;
      top: 50%;
      right: 100%;
      margin-top: -5px;
      border-width: 5px;
      border-style: solid;
      border-color: transparent #292929 transparent transparent;
    }

    /* Browser Image Viewer (webview) touchpoint overrides */
    .browserImageViewer .cdf40d50ba-express-edit-cta-button {
        justify-content: start;
        border-width: 1px;
        border-color: #4B4B4B;
        padding-right: 10px;
        box-sizing: unset !important;
        -webkit-box-sizing: unset !important;
        -moz-box-sizing: unset !important;
    }

    .browserImageViewer .cdf40d50ba-express-edit-cta-icon,
    .browserImageViewer .cdf40d50ba-express-edit-cta-icon img {
        width: 20px;
        height: 20px;
    }

    .browserImageViewer .cdf40d50ba-express-expand-menu-icon-container {
        width: 0;
        opacity: 0;
        pointer-events: none;
        overflow: hidden;
        padding: 0;
        margin: 0;
        transition: width 300ms ease, opacity 300ms ease;
    }

    .browserImageViewer .cdf40d50ba-express-menu-item-text {
        width: auto;
        margin-right: 4px;
    }

    .browserImageViewer .cdf40d50ba-express-hover-cta:hover .cdf40d50ba-express-expand-menu-icon-container,
    .browserImageViewer .expand-menu-open .cdf40d50ba-express-expand-menu-icon-container {
        width: 24px;
        height: 24px;
        opacity: 1;
        pointer-events: auto;
        padding: unset;
        margin: unset;
    }

    .browserImageViewer .cdf40d50ba-express-floating-menu {
        padding: 8px;
        border-radius: 10px;
        border: none;
        background: #2C2C2C;
        gap: 2px;
    }

    .browserImageViewer .cdf40d50ba-express-floating-menu-item {
        height: 24px;
        padding: 0 9px;
        border-radius: 7px;
        color: rgba(255, 255, 255, 0.9);
    }

    .browserImageViewer .cdf40d50ba-express-floating-menu-item:hover {
        background-color: #0265DC;
        color: #FFFFFF;
    }

    .browserImageViewer .cdf40d50ba-express-floating-menu-item-text {
        font-size: 12px;
        width: 95px;
    }

    .browserImageViewer.cc440d50ba-tooltiptext {
        width: 160px;
        padding: 7px 9px;
        background-color: #DBDBDB;
        color: #111111;
    }

    .browserImageViewer.cc440d50ba-tooltiptext-bottom::after {
        border-color: transparent transparent #F5F5F5 transparent;
    }

    .browserImageViewer.cdf40d50ba-express-expand-menu-icon {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .browserImageViewer.cdf40d50ba-express-expand-menu-icon svg  {
        width: 16px;
        height: 16px;
        padding: 0;
    }

    .browserImageViewer .expand-menu-open .cdf40d50ba-burger-icon {
        display: flex;
    }

    .browserImageViewer .expand-menu-open .cdf40d50ba-close-icon {
        display: none;
    }

    /* Browser Image Viewer: always use dark palette (ignores prefers-color-scheme) */
    .browserImageViewer .cdf40d50ba-express-hover-cta {
        background-color: #2C2C2C;
        color: rgba(255, 255, 255, 0.9);
    }

    .browserImageViewer .cdf40d50ba-express-edit-cta-button:hover {
        background-color: #3A3A3A;
        border-color: #5A5A5A;
        box-shadow: none;
    }

    .browserImageViewer .cdf40d50ba-express-expand-menu-icon:hover {
        background-color: #4B4B4B;
    }

    .browserImageViewer .cdf40d50ba-express-expand-menu-icon svg path {
        fill: rgba(255, 255, 255, 0.9);
    }

    .browserImageViewer .cdf40d50ba-express-expand-menu-icon:hover svg path {
        fill: rgba(255, 255, 255, 1);
    }

    .browserImageViewer .cdf40d50ba-express-floating-menu {
        background: rgba(34, 34, 34, 1);
        transition: none;
    }


    /* Dark mode styles */
    @media (prefers-color-scheme: dark) {
      .cdf40d50ba-express-hover-cta {
        background-color: #2C2C2C;
        color: rgba(255, 255, 255, 0.9);
      }

      .cdf40d50ba-express-edit-cta-button {
        border-color: #4B4B4B;
      }

      .cdf40d50ba-express-edit-cta-button:hover {
        background-color: #3A3A3A;
        border-color: #5A5A5A;
      }

      .cdf40d50ba-express-floating-menu {
        background: #2C2C2C;
        border: 1px solid #4B4B4B;
      }

      .cdf40d50ba-express-floating-menu-item {
        color: rgba(255, 255, 255, 0.9);
      }

      .cdf40d50ba-express-floating-menu-item:hover {
        background-color: #3A3A3A;
      }

      .cdf40d50ba-express-menu-footer {
        color: #B1B1B1;
      }

      .cdf40d50ba-express-floating-menu-footer-text {
        color: #9A9A9A;
      }

      .cdf40d50ba-express-expand-menu-icon:hover {
        background-color: #4B4B4B;
      }

      .cdf40d50ba-express-expand-menu-icon svg path {
        fill: rgba(255, 255, 255, 0.9);
      }

      .cdf40d50ba-express-expand-menu-icon:hover svg path {
        fill: rgba(255, 255, 255, 1);
      }

      .cc440d50ba-tooltiptext {
        background-color: #F5F5F5;
        color: #1C1C1C;
      }

      .cc440d50ba-tooltiptext-bottom::after {
        border-color: transparent transparent #F5F5F5 transparent;
      }

      .cc440d50ba-tooltiptext-top::after {
        border-color: #F5F5F5 transparent transparent transparent;
      }

      .cc440d50ba-tooltiptext-left::after {
        border-color: transparent transparent transparent #F5F5F5;
      }

      .cc440d50ba-tooltiptext-right::after {
        border-color: transparent #F5F5F5 transparent transparent;
      }

     .browserImageViewer.cc440d50ba-tooltiptext {
        background-color: #DBDBDB;
        color: #111111;
      }

     .browserImageViewer .cdf40d50ba-express-floating-menu {
        background: rgba(34, 34, 34, 1);
      }
    }

</style>

